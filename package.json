{
  "name": "deckmate",
  "version": "0.1.0",
  "description": "Schachspiel mit kartenbasiertem Zug-System",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/tsconfig.json",
    "dev": "vite",
    "build:ui": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:firebase": "tsx scripts/test-firebase.ts",
    "test:presence": "tsx scripts/test-presence.ts",
    "test:friends": "tsx scripts/test-friends.ts",
    "migrate:emails": "tsx scripts/migrate-emails.ts",
    "emulator": "firebase emulators:start",
    "electron:dev": "electron .",
    "electron:build": "npm run build:ui && electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --only database --project demo-deckmate \"vitest run --config vitest.rules.config.ts\""
  },
  "main": "electron.js",
  "build": {
    "appId": "com.deckmate.app",
    "productName": "Deckmate",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.js"
    ],
    "asar": false,
    "electronUpdaterCompatibility": ">=2.17.0",
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "firebase": "^10.12.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^4.0.18",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.5.0",
    "prettier": "^3.9.8",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
