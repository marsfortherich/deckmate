rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - Allow list queries for username checks
    match /users/{document=**} {
      // Allow read for all authenticated users (includes collection queries)
      allow read: if request.auth != null;
    }
    
    // Users collection - Document-level rules
    match /users/{userId} {
      // Only the user can write their own document
      // During registration, after createUserWithEmailAndPassword, auth.uid exists
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
      
      // Friends subcollection
      match /friends/{friendId} {
        // User can read their own friends list
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // User can write to their own friends list
        // OR when accepting a friend request, user can write themselves into another user's list
        // Examples:
        // - UserA writes to /users/UserA/friends/UserB (userId == auth.uid) ✓
        // - UserB accepts request from UserA and writes to /users/UserA/friends/UserB (friendId == auth.uid) ✓
        allow write: if request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == friendId);
      }
      
      // Decks subcollection
      match /decks/{deckId} {
        // Only the user can read/write their own decks
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Friend Requests collection
    match /friendRequests/{requestId} {
      // Users can read requests where they are sender or receiver
      // For non-existent documents, this will deny access (which is caught in code)
      allow read: if request.auth != null && 
        (resource == null || 
         resource.data.from == request.auth.uid || 
         resource.data.to == request.auth.uid);
      
      // Users can create requests where they are the sender
      allow create: if request.auth != null && 
        request.resource.data.from == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      // Users can delete requests where they are sender or receiver
      allow delete: if request.auth != null && 
        (resource.data.from == request.auth.uid || 
         resource.data.to == request.auth.uid);
         
      // No updates allowed (delete and create new instead)
      allow update: if false;
    }
    
    // Matches collection
    match /matches/{matchId} {
      // Players can read matches where they are involved:
      // - As a player in the match
      // - As the challenged user (incoming challenge)
      // - As the challenger (outgoing challenge)
      allow read: if request.auth != null && 
        (request.auth.uid in resource.data.players ||
         (resource.data.challengeData != null && 
          (request.auth.uid == resource.data.challengeData.challengedId ||
           request.auth.uid == resource.data.challengeData.challengerId)));
      
      // Any authenticated user can create a match (challenge)
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.players &&
        request.resource.data.mode == 'unranked' &&
        (request.resource.data.status == 'pending' || 
         request.resource.data.status == 'pending_challenge');
      
      // Both players can update the match
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.players;
      
      // Both players can delete the match (decline challenge)
      allow delete: if request.auth != null && 
        request.auth.uid in resource.data.players;
    }
  }
}