rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Firestore rules are permissive-OR: if any matching rule allows access it
    // is granted, and a narrower rule cannot take it away. So a recursive
    // `match /users/{document=**}` read would expose every subcollection -
    // decks and friends included - no matter what the rules below say. The
    // read allowance is therefore scoped to the user documents themselves.
    match /users/{userId} {
      // Any signed-in user may read user documents, and query the collection.
      // findUserByEmail / findUserByUsername depend on this.
      // NOTE: this exposes stored emails to any authenticated account. Moving
      // those lookups behind a Cloud Function is tracked in ROADMAP.md.
      allow read: if request.auth != null;

      // Only the user can write their own document.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;

      // Friends subcollection
      match /friends/{friendId} {
        // User can read their own friends list
        allow read: if request.auth != null && request.auth.uid == userId;

        // User can write to their own friends list, OR write themselves into
        // another user's list when accepting that user's friend request.
        allow write: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }

      // Decks subcollection - a deck is hidden information in a match, so it
      // is readable only by its owner.
      match /decks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Friend Requests collection
    match /friendRequests/{requestId} {
      // Users can read requests where they are sender or receiver.
      // For non-existent documents this denies access, which is caught in code.
      allow read: if request.auth != null &&
        (resource == null ||
         resource.data.from == request.auth.uid ||
         resource.data.to == request.auth.uid);

      // Users can create requests where they are the sender
      allow create: if request.auth != null &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Users can delete requests where they are sender or receiver
      allow delete: if request.auth != null &&
        (resource.data.from == request.auth.uid ||
         resource.data.to == request.auth.uid);

      // No updates allowed (delete and create new instead)
      allow update: if false;
    }

    // Matches collection
    match /matches/{matchId} {
      function isPlayer() {
        return request.auth != null && request.auth.uid in resource.data.players;
      }

      // Fields that must never change after the match is created. Without
      // this, either player could rewrite the participant list or the mode.
      function identityUnchanged() {
        return request.resource.data.players == resource.data.players &&
               request.resource.data.mode == resource.data.mode &&
               request.resource.data.createdAt == resource.data.createdAt;
      }

      // Players can read matches where they are involved:
      // as a player, as the challenged user, or as the challenger.
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.players ||
         (resource.data.challengeData != null &&
          (request.auth.uid == resource.data.challengeData.challengedId ||
           request.auth.uid == resource.data.challengeData.challengerId)));

      // Any authenticated user can create a match (challenge) they are part of
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.players &&
        request.resource.data.mode == 'unranked' &&
        (request.resource.data.status == 'pending' ||
         request.resource.data.status == 'pending_challenge');

      // Both players can update the match, but not its identity
      allow update: if isPlayer() && identityUnchanged();

      // Both players can delete the match (decline challenge)
      allow delete: if isPlayer();
    }
  }
}
